# Kopie als deploy/wissensraum.env anlegen (nicht ins Repository). Keine Geheimnisse hier, die liegen in secrets/.
WR_BASE_URL=https://wissen.melchy.cloud
WR_OIDC_TENANT_ID=<tenant-id>
WR_OIDC_CLIENT_ID=<client-id>
WR_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# Ablaufdatum des Client-Geheimnisses aus Entra ID; Warnung in Log und Verwaltung ab 30 Tagen vorher
WR_OIDC_CLIENT_SECRET_EXPIRES=<JJJJ-MM-TT>
DB_HOST=<name-des-postgres-containers>
DB_PORT=5432
DB_DATABASE=wissensraum_server
DB_USERNAME=wissensraum_app
DB_PASSWORD_FILE=/run/secrets/db_app
# TLS ist Pflicht außer für localhost (database.py); der PostgreSQL-Container braucht ssl=on.
DB_SSLMODE=require
WR_AI_PROVIDER=ollama
WR_AI_MODEL=qwen3:8b
# gilt für Antworten und Einbettungen (Server und Worker)
WR_OLLAMA_URL=http://<name-des-ollama-containers>:11434
# Ordner für den Installationsexport, gleiches Volume in Server und Worker
WR_EXPORT_DIR=/data/exports
# optional: Sekunden zwischen zwei Runden des Workers (Standard 30)
# WR_WORKER_INTERVAL=30
# Adresse des Traefik-Containers im Proxy-Netz, damit Rate Limits und Audit die echte Quelladresse sehen.
WR_FORWARDED_ALLOW_IPS=<traefik-ip>
